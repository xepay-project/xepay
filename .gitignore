# ------------------------------------------------------------
# Rust / Cargo build artifacts
# ------------------------------------------------------------
/target/
**/*.rs.bk
*.pdb
*.profraw
*.profdata

# Incremental compilation cache (redundant with /target/, kept explicit)
/target/debug/incremental/
/target/release/incremental/

# ------------------------------------------------------------
# Cargo lockfile policy
# ------------------------------------------------------------
# XEPY is a BINARY crate (it declares [[bin]] in Cargo.toml).
# For binaries, Cargo.lock SHOULD be committed to guarantee
# reproducible builds. Do NOT ignore it.
# (This section intentionally left as documentation.)
# Cargo.lock

# ------------------------------------------------------------
# Cargo tooling artifacts
# ------------------------------------------------------------
# `cargo doc` output
/doc/

# `cargo bench` / criterion output
/criterion/
**/criterion/

# `cargo tarpaulin` / llvm-cov coverage
/coverage/
*.profraw
*.profdata
*.lcov
lcov.info
tarpaulin-report.*

# `cargo mutants` output
/mutants.out/
mutants.out.old/

# `cargo audit` local DB (rare, but possible)
.cargo-audit/

# Vendored dependencies (only ignore if you do NOT vendor)
# /vendor/

# ------------------------------------------------------------
# Debug / profiling / tracing artifacts
# ------------------------------------------------------------
*.log
/perf.data*
/perf.script*
flamegraph.svg
*.folded
*.nsys-rep

# Core dumps
core
core.*
*.core

# ------------------------------------------------------------
# Environment & secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
.secrets/

# ------------------------------------------------------------
# Blockchain runtime data (if you later add persistence)
# ------------------------------------------------------------
/data/
/chain/
/wallet/
*.db
*.sqlite
*.sqlite3
*.sled
*.rocksdb/

# ------------------------------------------------------------
# Node / P2P runtime (if you later add networking)
# ------------------------------------------------------------
/peers.json
/nodes/
*.pid

# ------------------------------------------------------------
# IDE / Editor
# ------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
!.vscode/launch.json.example

# JetBrains (RustRover, IntelliJ, CLion)
.idea/
*.iml
*.iws
*.ipr
out/

# Vim / Neovim
*.swp
*.swo
*.swn
*~
.vim/
.nvim/

# Emacs
*#
.#*
.\#*
.emacs.d/
.projectile

# Sublime Text
*.sublime-workspace
*.sublime-project

# Zed
.zed/

# Helix
.helix/

# Kate / KDevelop
.kdev4/
*.kdev4
.kate-swp

# ------------------------------------------------------------
# OS noise
# ------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Icon?
.fseventsd

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# Linux
*~
.directory
.Trash-*
.nfs*

# ------------------------------------------------------------
# Language / toolchain specifics
# ------------------------------------------------------------
# rust-analyzer cache (usually inside target, but just in case)
.rust-analyzer/

# rustfmt backup
*.rs.bk

# Clippy cache (usually inside target)
.clippy.toml.local

# sccache
.sccache/

# mold linker temp
*.mold.*

# ------------------------------------------------------------
# CI / local test artifacts
# ------------------------------------------------------------
/.github/workflows/*.local.yml
/ci/local/
*.test.log
test-results/
junit.xml

# ------------------------------------------------------------
# Documentation
# ------------------------------------------------------------
# Keep README/LICENSE, ignore generated docs
/book/
/_site/
*.html.bak

# ------------------------------------------------------------
# Misc
# ------------------------------------------------------------
*.bak
*.orig
*.rej
*.tmp
*.temp
*.cache
.cache/
tmp/
temp/
